# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  openssl rand -base64 48

# ── Core ───────────────────────────────────────────────
APP_ENV=development            # development | production
LOG_LEVEL=info
APP_URL=http://localhost:3000  # public URL of the web app (used in unsubscribe links)
API_URL=http://localhost:8080
# Sender of account emails (verification codes, team invitations). Locally they land in Mailpit.
SYSTEM_EMAIL_FROM=no-reply@leadline.test
SYSTEM_EMAIL_NAME=Leadline

# ── Database & Redis/Valkey ────────────────────────────
# docker-compose builds DATABASE_URL from these; set DATABASE_URL directly when running outside Compose.
POSTGRES_USER=leadline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leadline
# DATABASE_URL=postgres://leadline:change-me@localhost:5432/leadline?sslmode=disable
# REDIS_URL=redis://localhost:6379/0

# ── Auth & signing (required, >= 32 chars each) ────────
JWT_SECRET=
SESSION_SECRET=
# HMAC secret for /api/v1/webhooks/email/generic (required in production)
WEBHOOK_SECRET=
# 32 random bytes, base64 — encrypts integration API keys, mailbox passwords and
# webhook secrets. Required for Integrations, per-mailbox SMTP/IMAP and webhooks.
# Changing it makes stored credentials unreadable.  openssl rand -base64 32
ENCRYPTION_KEY=

# ── Email sending ──────────────────────────────────────
# smtp: any SMTP relay (Mailpit locally; SES, SendGrid, Mailgun, Postmark all offer SMTP)
# log:  don't send, only log metadata
EMAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=none                  # none | starttls | tls

# ── Email verification ─────────────────────────────────
VERIFIER_MX_LOOKUP=true
# Development only: treat *.example / *.test addresses as valid so demo data flows to Mailpit.
VERIFIER_ALLOW_TEST_DOMAINS=true

# ── AI: personalized openers + reply classification ────
# anthropic | none. With "none", openers are disabled and replies are
# classified by rules (opt-outs are always rule-based).
LLM_PROVIDER=none
LLM_API_KEY=
# Optional model override (default claude-opus-5-5).
LLM_MODEL=

# ── Company database (company-scraper) ─────────────────
# Companies are discovered, website-checked and verified by the separate
# company-scraper project; Leadline searches its database read-only and imports
# the companies you pick. Use its leadline_reader role (READER_PASSWORD in
# company-scraper/.env). "company-db" resolves over the shared Docker network
# "company-data"; outside Docker use localhost:5433.
SCRAPER_DATABASE_URL=postgres://leadline_reader:change-me-too@company-db:5432/scraper?sslmode=disable

# ── Inbox sync (IMAP) ──────────────────────────────────
INBOX_POLL_INTERVAL=2m

# ── Host ports (change if 3000/8080/8025 are taken; keep APP_URL in sync) ──
FRONTEND_PORT=3000
API_PORT=8080
MAILPIT_PORT=8025

# ── Workers ────────────────────────────────────────────
SCHEDULER_INTERVAL=30s
WORKER_CONCURRENCY=8
WORKER_REPLICAS=1

# ── Demo mode ──────────────────────────────────────────
# true: the web app runs on an in-browser mock backend with sample data
# (login, leads, campaigns, integrations… all simulated; nothing hits the API
# or database). false: everything is served by the Go API and PostgreSQL.
# Rebuild the frontend after changing it: docker compose up -d --build frontend
MOCK_MODE=false
